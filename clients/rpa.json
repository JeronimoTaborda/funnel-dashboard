      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Submission Date"
      },
      "funnel": false,
      "activity": {
        "label": "Qualified as Hot Lead",
        "metaFields": [
          "Overall Score"
        ]
      }
    },
    {
      "id": "closed",
      "label": "Program customer",
      "short": "Customer",
      "tab": "Ticket Buyers - UTM Tracking Sheet",
