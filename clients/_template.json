  "stages": [
    {
      "id": "ticket",
      "label": "Compró ticket del webinar",
      "short": "Ticket",
      "tab": "Ticket Buyers - UTM Tracking Sheet",
      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Registration Date",
        "value": "Revenue"
      },
      "activity": {
        "label": "Compró el ticket del webinar",
        "metaFields": [
          "UTM Source Latest",
          "UTM Content Latest",
          "Ads or Organic?"
        ]
      }
    },
    {
      "id": "quiz",
      "label": "Completó el quiz de intención",
      "short": "Quiz",
      "tab": "Webinar Ticket Purchase Quiz Responses",
      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Submission Date"
      },
      "activity": {
        "label": "Completó el quiz de intención",
        "metaFields": [
          "Tier",
          "Overall Score"
        ]
      }
    },
    {
      "id": "hot",
      "label": "Calificado como Hot Lead",
      "short": "Hot Lead",
      "tab": "Webinar Ticket Purchase Quiz Responses",
      "when": {
        "field": "Tier",
        "in": [
          "Hot Lead"
        ]
      },
      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Submission Date"
      },
      "funnel": false,
      "activity": {
        "label": "Calificó como Hot Lead",
        "metaFields": [
          "Overall Score"
        ]
      }
    },
    {
      "id": "closed",
      "label": "Cerró el programa",
      "short": "Cerró",
      "tab": "Ticket Buyers - UTM Tracking Sheet",
      "when": {
        "field": "Closed",
        "notEmpty": true
      },
      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Closed",
        "value": "Program Revenue"
      },
      "activity": {
        "label": "Cerró el programa",
        "metaFields": [
          "Webinar Cycle Closed"
        ]
      }
    },
    {
      "id": "lead",
      "funnel": false,
      "label": "Lead magnet — quiz de reconexión",
      "short": "Lead magnet",
      "tab": "Lead Magnets Tracker",
      "map": {
        "email": "Email",
        "name": "Full Name",
        "phone": "Phone",
        "date": "Submitted At"
      },
      "activity": {
        "label": "Completó el quiz de reconexión (lead magnet)",
        "metaFields": [
          "persona Label",
          "looking_for"
        ]
      }
    },
    {
      "id": "txn",
      "funnel": false,
      "label": "Transacciones registradas",
      "short": "Transacciones",
      "tab": "Program Buyers",
      "map": {
        "email": "Email",
        "name": [
          "First Name",
          "Last Name"
        ],
        "phone": "Phone",
        "date": "Transaction Date",
